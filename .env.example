# AppSeal - шаблон переменных окружения.
# Локально: скопировать в .env.local (не коммитится) или в общий D:\BIR\.env.
# Прод: Vercel -> Settings -> Environment Variables.
# Дизайн осознанно без fail-fast валидации: отсутствие опционального ключа
# деградирует фичу, но не валит сайт при старте.

# ---------- Ядро ----------
# Upstash Redis (REST) - стор сканов, пропусков, реестра, квот.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Публичный origin (self-origin тиков, canonical, return_url).
# Фоллбэк: https://appseal.online
NEXT_PUBLIC_APP_URL=https://appseal.online

# Postgres (Supabase pooler, порт 6543) - зеркало пропусков, отзывы,
# ledger платежей, движения грейдов. Без него всё перечисленное
# деградирует до Redis-only.
DATABASE_URL=

# ---------- Монетизация ----------
# ЮKassa (RU-карты, чеки НПД самозанятого)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
# Переопределение allowlist IP вебхуков ЮKassa (по умолчанию официальный диапазон)
YOOKASSA_WEBHOOK_IPS=

# Lava.top (инокарты) - API-ключ, секрет вебхука и офферы продуктов
LAVATOP_API=
LAVATOP_WEBHOOK_SECRET=
# Оффер Launch Pass / Agency Pack / Pro Pass
LAVA_OFFER_ID=
LAVA_PACK_OFFER_ID=
LAVA_PRO_OFFER_ID=

# Соль солёного хеша IP для дневной квоты (152-ФЗ). Без неё соль выводится
# из рантайм-секрета - бакеты квоты теряют консистентность между инстансами.
QUOTA_SALT=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Секрет в пути вебхука бота
TELEGRAM_WEBHOOK_SECRET=

# ---------- Кроны и служебные ----------
# Секрет тиков monitor/digest/pipeline (GitHub Actions workflows)
TICK_SECRET=
# Admin-ключ: обход квот в /api/scan, /api/ops/scan-keys
ADMIN_SCAN_KEY=
# Bearer для /api/registry/ingest (батч-заливка реестра)
REGISTRY_INGEST_KEY=
# Доп. "свои" хосты через запятую (бейдж/PDF без пропуска), поверх встроенного набора
SELF_HOSTS=
# Выключить JS-рендеринг сканера: off (по умолчанию включён)
APPSEAL_RENDER=

# ---------- Скрипты (локальные запуски scripts/) ----------
# Папка ассетов для генераторов PDF-отчётов
APPSEAL_PDF_SKILL_DIR=
# Python-скрипты читают UPSTASH_REDIS_REST_URL/TOKEN из того же окружения
